bcftools norm -f ../Week-5/fasta/GCA_000002425.2_Phypa_V3_genomic.fna -c e -m -any -Oz -o results/ERR8982185.normalized.vcf.gz results/ERR8982185.raw.vcf.gz 2> provenance/normalization.log
bcftools filter -s LowQualOrDepth -e 'QUAL<20 || FMT/DP<3' -Oz -o results/ERR8982185.filtered.vcf.gz results/ERR8982185.normalized.vcf.gz
